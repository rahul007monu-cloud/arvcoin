# Local verification harness — tests and a static server, not part of the app
.verify/

# ---------------------------------------------------------------------------
# NEVER COMMIT THIS FILE.
#
# install.php writes the MySQL password, the app signing key and the mail
# settings here. It lives only on the server. If it is ever committed, rotate
# the database password and the app key immediately — the key signs sessions and
# hashes OTPs, so a leaked one is a way into every account.
# ---------------------------------------------------------------------------
api/config.local.php

# Payment screenshots users upload — other people's bank statements.
uploads/

