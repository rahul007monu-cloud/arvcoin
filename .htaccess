# Apache configuration for static hosting (Hostinger, cPanel, shared hosts).
# Ignored by Netlify, Vercel and Cloudflare Pages — configure those in their own
# dashboards.

# ---------------------------------------------------------------- MIME types --
# Some shared hosts serve .js as application/javascript with no charset, or fail
# to recognise .mjs at all, and the browser then refuses to execute the module.
# Everything here is ES modules, so getting this wrong breaks the whole app.
AddType text/javascript .js
AddType text/javascript .mjs
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

# ------------------------------------------------------------------- caching --
<IfModule mod_expires.c>
  ExpiresActive On

  # Never cache HTML: a stale shell can pin users to an old service worker.
  ExpiresByType text/html "access plus 0 seconds"

  # The service worker must always be revalidated, or a deploy never lands.
  <FilesMatch "sw\.js$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Config is edited in place, so it must not be cached either.
  <FilesMatch "arv-config\.js$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  ExpiresByType text/javascript "access plus 1 hours"
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
</IfModule>

# ---------------------------------------------------------------- compression -
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------------- security -
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # HSTS. Only meaningful once HTTPS is actually in place — the service worker
  # and the exchange WebSockets both require it.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ------------------------------------------------------------------ HTTPS ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Clean URLs: /charts serves charts.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ------------------------------------------------------------------- hygiene --
# Nothing here should ever be web-readable.
<FilesMatch "\.(md|sql|ts|log|yml|yaml)$">
  Require all denied
</FilesMatch>

RedirectMatch 404 /\.git
RedirectMatch 404 /supabase/
RedirectMatch 404 /\.verify

Options -Indexes
