# arvcoin — Apache config (Hostinger)

# Web3Auth/Google login POPUP ko opener (arvcoin.com) se baat karne do.
# Bina iske "Verify your Google account" pe hang hota hai (COOP window.closed block).
<IfModule mod_headers.c>
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

# sw.js + wallet-bundle.js hamesha fresh mile (purana cache/SW toड़ta hai)
<IfModule mod_headers.c>
  <FilesMatch "(sw|wallet-bundle)\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
