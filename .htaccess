# Apache configuration for static hosting (Hostinger, cPanel, shared hosts).
# Ignored by Netlify, Vercel and Cloudflare Pages — configure those in their own
# dashboards.

# ---------------------------------------------------------------- MIME types --
# Some shared hosts serve .js as application/javascript with no charset, or fail
# to recognise .mjs at all, and the browser then refuses to execute the module.
# Everything here is ES modules, so getting this wrong breaks the whole app.
AddType text/javascript .js
AddType text/javascript .mjs
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

# ------------------------------------------------------------------- caching --
<IfModule mod_expires.c>
  ExpiresActive On

  # Never cache HTML: a stale shell can pin users to an old service worker.
  ExpiresByType text/html "access plus 0 seconds"

  # Scripts and styles are revalidated, not cached for an hour.
  #
  # Filenames here are not content-hashed — js/pages/profile.js is the same URL in
  # every release — so any max-age is a window during which a deployed fix is not
  # what the browser is actually running. An hour of that is how "I merged it,
  # deployed it, and nothing changed" happens, and it did happen here.
  #
  # A conditional request costs a 304 with no body, and there are about thirty of
  # these files. That is a far better trade than running an hour behind on the code
  # that prices somebody's money.
  #
  # This block is first on purpose: the two overrides below must win, and for
  # `Header set` the last matching section is the one that applies.
  <FilesMatch "\.(js|mjs|css)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Config is edited in place on the server, so it must never be held.
  <FilesMatch "arv-config\.js$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # The service worker gets the strongest form. Stored even briefly, it can pin a
  # browser to the previous release's caching rules — which is the one thing that
  # can outlive every other fix here.
  <FilesMatch "sw\.js$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Genuinely static, and not worth revalidating.
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# ---------------------------------------------------------------- compression -
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------------- security -
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # HSTS. Only meaningful once HTTPS is actually in place — the service worker
  # and the exchange WebSockets both require it.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ------------------------------------------------------------------ HTTPS ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Clean URLs: /charts serves charts.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ------------------------------------------------------------------- hygiene --
# Nothing here should ever be web-readable.
<FilesMatch "\.(md|sql|ts|log|yml|yaml)$">
  Require all denied
</FilesMatch>

RedirectMatch 404 /\.git
RedirectMatch 404 /supabase/
RedirectMatch 404 /\.verify

Options -Indexes
