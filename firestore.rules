rules_version = '2';

/* =========================================================
   arvcoin — Firestore security rules

   ASLI GATING YAHAN HOTI HAI. Client-side check sirf UX ke liye hai —
   koi bhi DevTools kholke bypass kar sakta hai. Paid calls sirf tab
   readable hain jab is file ke hisaab se subscription active ho.

   Golden rules:
     - wallets / subscriptions / ledger  -> client se NEVER writable
       (sirf Cloud Functions admin SDK se, verified payment ke baad)
     - calls (full detail)               -> active + covering subscription chahiye
     - callTeasers                       -> public (SEO + funnel)
   ========================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /* ---------- roles ----------
       Two ways to be an admin/analyst:

       1) A custom auth claim (set by tools/grant-admin.js). Fastest at
          runtime — no extra document read.

       2) A document in /admins/{uid}. This exists so the owner can grant
          access from the Firebase Console with no terminal required.

       Reading the role from /admins is SAFE because that collection is
       never client-writable (see its rule below) — only the Console or
       the Admin SDK can write there. Reading a role from /users/{uid}
       would NOT be safe, since users can edit their own profile. */

    function adminDoc() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (adminDoc() &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true)
      );
    }

    function isAnalyst() {
      return signedIn() && (
        request.auth.token.analyst == true ||
        request.auth.token.admin == true ||
        (adminDoc() &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.analyst == true)
      );
    }

    function subDoc() {
      return get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data;
    }

    function hasSubDoc() {
      return signedIn() &&
             exists(/databases/$(database)/documents/subscriptions/$(request.auth.uid));
    }

    function subActive() {
      return hasSubDoc() &&
             subDoc().status == 'active' &&
             subDoc().activeTill > request.time;
    }

    // Subscription is segment ko cover karta hai?
    function subCovers(seg) {
      return subActive() && subDoc().segments.hasAny([seg]);
    }

    /* ---------- users ----------
       Apna profile padh/likh sakte ho, par role/entitlement fields
       ko client se chhoo nahi sakte. */
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
                    && !request.resource.data.keys().hasAny(
                         ['role','admin','analyst','arvBalance','subscription','founderMember']);
      allow update: if (isMe(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                         ['role','admin','analyst','arvBalance','subscription','founderMember','createdAt']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    /* ---------- wallets (ARV credits) ----------
       Balance sirf Cloud Function badalta hai. Agar client likh paata
       to koi bhi apne aap ko infinite credits de deta. */
    match /wallets/{uid} {
      allow read:  if isMe(uid) || isAdmin();
      allow write: if false;      // admin SDK bypasses rules
    }

    /* ---------- ledger (append-only audit trail) ----------
       Har credit/debit ka record. Client kuch nahi kar sakta. */
    match /ledger/{entryId} {
      allow read:  if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    /* ---------- subscriptions ----------
       Entitlement ka source of truth. Client se writable hona
       ka matlab hota free subscription sabke liye. */
    match /subscriptions/{uid} {
      allow read:  if isMe(uid) || isAdmin();
      allow write: if false;
    }

    /* ---------- payments ----------
       Razorpay orders. Client apna order padh sakta hai, likh nahi sakta —
       order Cloud Function banata hai aur webhook signature server pe
       verify hoti hai. Client "success" pe kabhi trust nahi. */
    match /payments/{orderId} {
      allow read:  if isAdmin() ||
                      (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    /* ---------- accessRequests (manual/offline grant ke liye) ----------
       User request BANA sakta hai par status khud nahi badal sakta —
       warna koi bhi apne aap ko 'paid' mark kar leta. */
    match /accessRequests/{reqId} {
      allow read: if isAdmin() ||
                     (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.planId is string
                    && request.resource.data.code is string;

      // Sirf admin grant/reject kar sakta hai
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ---------- plans (public catalogue) ---------- */
    match /plans/{planId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* ---------- settings ----------
       Admin-editable, publicly readable configuration: plan prices,
       payment QR / UPI details, contact info.

       This is what lets the owner change pricing and payment details
       from the admin panel instead of editing code. */
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* ---------- paymentProofs ----------
       Manual payment flow: the user pays via QR/UPI and submits a
       reference. Admin verifies and grants access.

       The user can create their own proof but cannot change its status —
       otherwise anyone could mark themselves as paid. */
    match /paymentProofs/{proofId} {
      allow read: if isAdmin() ||
                     (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.planId is string
                    && request.resource.data.reference is string
                    && request.resource.data.reference.size() >= 4;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ---------- callTeasers (PUBLIC) ----------
       Sirf title + segment + date. Koi entry/target/SL nahi.
       SEO aur funnel ke liye — Google index kar sake. */
    match /callTeasers/{callId} {
      allow read:  if true;
      allow write: if false;      // calls publish hone pe function likhta hai
    }

    /* ---------- calls (PAID, gated) ----------
       Poora research call: entry, targets, SL, rationale.
       Do condition: subscription active HO, aur us segment ko cover kare. */
    match /calls/{callId} {
      allow read: if isAnalyst() || subCovers(resource.data.segment);

      // Publish sirf analyst/admin kar sakta hai, aur RA registration
      // details mandatory hain (SEBI requirement).
      allow create: if isAnalyst()
                    && request.resource.data.raNumber is string
                    && request.resource.data.raNumber.size() >= 6
                    && request.resource.data.analystName is string
                    && request.resource.data.analystName.size() > 0
                    && request.resource.data.rationale is string
                    && request.resource.data.rationale.size() >= 20
                    && request.resource.data.segment in
                       ['equity','options','commodity','currency','crypto'];

      // Append-only spirit: status/exit update ho sakta hai, par
      // original recommendation immutable hai — loss chhupaya na ja sake.
      allow update: if isAnalyst()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                         ['segment','instrument','action','entry','targets','stopLoss',
                          'raNumber','analystName','publishedAt']);

      allow delete: if false;     // calls kabhi delete nahi hote
    }

    /* ---------- call revisions (audit trail) ---------- */
    match /calls/{callId}/revisions/{revId} {
      allow read:  if isAnalyst() || subCovers(get(/databases/$(database)/documents/calls/$(callId)).data.segment);
      allow create: if isAnalyst();
      allow update, delete: if false;
    }

    /* ---------- analysis (levels + structure) ----------
       Calculator ka output + analyst ka structural observation.
       Koi buy/sell action, entry, target ya stop-loss field NAHI —
       isliye RA registration ka gate yahan lagu nahi hota.

       ⚠️ Is schema me kabhi bhi action/entry/target/stopLoss
       fields NA add karna. Field add karte hi ye recommendation
       ban jaayega aur registration ke bina illegal ho jaayega. */
    match /analysis/{docId} {
      allow read: if resource.data.free == true || subActive() || isAnalyst();

      allow create: if isAnalyst()
                    && request.resource.data.instrument is string
                    && request.resource.data.segment in
                       ['equity','options','commodity','currency','crypto']
                    && request.resource.data.observation is string
                    && request.resource.data.observation.size() >= 20
                    // recommendation fields blocked at the rules layer
                    && !request.resource.data.keys().hasAny(
                         ['action','entry','targets','target','stopLoss','sl',
                          'recommendation','rating','callType','expectedReturn']);

      allow update: if isAnalyst()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                         ['instrument','segment','levels','publishedAt'])
                    && !request.resource.data.keys().hasAny(
                         ['action','entry','targets','target','stopLoss','sl',
                          'recommendation','rating','callType','expectedReturn']);

      allow delete: if isAdmin();
    }

    /* ---------- lessons (education, free + gated) ---------- */
    match /lessons/{lessonId} {
      allow read: if resource.data.free == true || subActive() || isAnalyst();
      allow write: if isAnalyst();
    }

    /* ---------- market recap (free, daily) ---------- */
    match /recaps/{recapId} {
      allow read:  if true;
      allow write: if isAnalyst();
    }

    /* ---------- growth metrics (public, platform activity only) ----------
       Subscribers / calls published / community size.
       NOTE: ye ARV ka price chart NAHI hai. Yahan koi ₹ value na daalo. */
    match /growth/{docId} {
      allow read:  if true;
      allow write: if false;      // function aggregate karta hai
    }

    /* ---------- paper trading (user ka apna simulator) ---------- */
    match /paperTrades/{uid}/trades/{tradeId} {
      allow read, write: if isMe(uid);
    }

    /* ---------- Q&A (moderated) ---------- */
    match /questions/{qId} {
      allow read:   if subActive() || isAnalyst();
      allow create: if subActive()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAnalyst();
      allow delete: if isAdmin();
    }

    /* ---------- referrals ---------- */
    match /referrals/{code} {
      allow read:  if signedIn();
      allow write: if false;      // function handle karta hai
    }

    /* ---------- waitlist (public form) ---------- */
    match /waitlist/{entryId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if isAdmin();
    }

    /* ---------- admins ----------
       Grants analyst/admin access without needing the CLI.

       Document ID must be the user's Firebase Auth UID.
       Fields: analyst = true, admin = true (both booleans)

       Client can read only its own document, and can NEVER write here.
       Writes come from the Firebase Console or the Admin SDK, both of
       which bypass these rules. That is what makes it safe to read a
       role from this collection. */
    match /admins/{uid} {
      allow read:  if isMe(uid);
      allow write: if false;
    }

    /* ---------- default deny ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
